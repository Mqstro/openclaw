# OpenClaw Pi5 Deployment — Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ──────────────────────────────────────────────────
# Gateway Authentication Token (REQUIRED)
# Generated automatically by setup.sh, or set manually.
# This token is used for API/CLI access to the gateway.
# ──────────────────────────────────────────────────
GATEWAY_TOKEN=

# ──────────────────────────────────────────────────
# Data Directories
# Where OpenClaw persists state and workspace files.
# Defaults are fine for most setups.
# ──────────────────────────────────────────────────
OPENCLAW_STATE_DIR=/opt/openclaw/state
OPENCLAW_WORKSPACE_DIR=/opt/openclaw/workspace

# ──────────────────────────────────────────────────
# Docker Image
# Use the hardened image built for ARM64/Pi5.
# ──────────────────────────────────────────────────
OPENCLAW_IMAGE=mqstro/openclaw:hardened

# ──────────────────────────────────────────────────
# Anthropic API Key (REQUIRED for Claude models)
# Obtain from https://console.anthropic.com/
# ──────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────────
# Backup Configuration (used by backup.sh)
# ──────────────────────────────────────────────────
BACKUP_LOCAL_DIR=/home/manu/backups/openclaw
BACKUP_REMOTE_HOST=root@217.154.169.120
BACKUP_REMOTE_DIR=/root/backups/pi5-daily
BACKUP_RETENTION_DAYS=30
